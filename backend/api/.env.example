# SQLAlchemy database URL. Defaults to a local SQLite file if unset.
DATABASE_URL=sqlite:///./nya_ai.db

# Secret used to sign JWTs. Set a real random value in production.
JWT_SECRET=dev-only-nya-ai-jwt-secret-change-me

# Optional: when set, the chat engine calls the Anthropic API for richer answers.
# When unset, the built-in keyword -> citation rule engine answers every message.
ANTHROPIC_API_KEY=

# Anthropic model id used when ANTHROPIC_API_KEY is set.
ANTHROPIC_MODEL=claude-sonnet-5

# Comma-separated list of allowed CORS origins for the frontend.
CORS_ORIGINS=http://localhost:5173

# Razorpay test-mode keys (rzp_test_...). Test mode needs zero KYC — get from the
# Razorpay dashboard. When unset, payment endpoints return 503; the rest of the app
# (free chat, lawyers, dashboard) still boots and works.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Signing secret for the webhook endpoint (set when registering the webhook URL).
RAZORPAY_WEBHOOK_SECRET=
