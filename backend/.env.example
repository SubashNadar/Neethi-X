# SQLAlchemy database URL. Defaults to a local SQLite file if unset.
DATABASE_URL=sqlite:///./neethi.db

# Secret used to sign JWTs. Set a real random value in production.
JWT_SECRET=dev-only-neethi-jwt-secret-change-me

# Optional: when set, the chat engine calls the Anthropic API for richer answers.
# When unset, the built-in keyword -> citation rule engine answers every message.
ANTHROPIC_API_KEY=

# Anthropic model id used when ANTHROPIC_API_KEY is set.
ANTHROPIC_MODEL=claude-sonnet-5

# Comma-separated list of allowed CORS origins for the frontend.
CORS_ORIGINS=http://localhost:5173
