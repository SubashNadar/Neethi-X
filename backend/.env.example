# Copy to backend/.env and fill in. Never commit .env.

# --- API ---
DATABASE_URL=sqlite:///./nya_ai.db

# Secret used to sign JWTs. Set a real random value in production.
JWT_SECRET=dev-only-nya-ai-jwt-secret-change-me

# Optional: when set, the chat engine calls the Anthropic API for richer answers.
# When unset, the built-in keyword -> citation rule engine answers every message.
ANTHROPIC_API_KEY=

# Anthropic model id used when ANTHROPIC_API_KEY is set.
ANTHROPIC_MODEL=claude-sonnet-5

# Comma-separated list of allowed CORS origins for the frontend.
CORS_ORIGINS=http://localhost:5173

# Razorpay test-mode keys (rzp_test_...). Test mode needs zero KYC — get from the
# Razorpay dashboard. When unset, payment endpoints return 503; the rest of the app
# (free chat, lawyers, dashboard) still boots and works.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Signing secret for the webhook endpoint (set when registering the webhook URL).
RAZORPAY_WEBHOOK_SECRET=

# --- Law library and agents ---
VECTOR_DATABASE_URL=postgresql+psycopg://nya:nya@localhost:5433/nya

# Azure OpenAI (personal subscription)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_EMBED_DEPLOYMENT=text-embedding-3-large
EMBED_DIM=1536

# Self-hosted Langfuse from docker-compose.yml. These match its LANGFUSE_INIT_* keys.
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-nya-local
LANGFUSE_SECRET_KEY=sk-lf-nya-local-change-me
