# Copy to nya-ai/.env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://nya:nya@localhost:5433/nya

# Azure OpenAI (personal subscription)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_EMBED_DEPLOYMENT=text-embedding-3-large
EMBED_DIM=1536

# Self-hosted Langfuse from docker-compose.yml. These match its LANGFUSE_INIT_* keys.
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-nya-local
LANGFUSE_SECRET_KEY=sk-lf-nya-local-change-me
